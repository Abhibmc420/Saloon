# Copy this file to ".env" and update the values before running the app.
# Example Postgres DATABASE_URL format:
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Local Postgres example (replace password):
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/Saloon

# Or use SQLite fallback (uncomment to use):
# DATABASE_URL=sqlite:///salon.db

# Optional: path for fallback sqlite file
# SQLITE_PATH=salon.db

# Google OAuth (create credentials at https://console.developers.google.com)
# GOOGLE_CLIENT_ID=<your-client-id>
# GOOGLE_CLIENT_SECRET=<your-client-secret>

# Admin credentials for quick local testing (override in production)
# ADMIN_USER=Admin
# ADMIN_PASS=admin123

# Paths for branding and hero images
# LOGO_PATH=H:\Company Setup\Project\Neerjazz_MakeOverSaloon\Celebrity Pics\logo.png
# HERO_IMAGES_PATH=H:\Company Setup\Project\Neerjazz_MakeOverSaloon\Celebrity Pics

# Notes:
# - Never commit your real credentials to source control. Use this file as a template only.
